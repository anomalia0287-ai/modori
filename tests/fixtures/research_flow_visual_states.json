  },
  "privacy": {
    "capture_scope": "application-content-only",
    "metadata_policy": "no-text-metadata",
    "forbidden_text_patterns": [
      "(?i)[a-z]:[\\\\/]",
      "(?i)\\\\users\\\\",
      "(?i)/home/",
      "(?i)onedrive|appdata|file://",
      "(?i)\\.(csv|xlsx|xls|sav|db|sqlite)(?:\\b|$)",
      "(?i)(?:project|ledger|event|artifact):[a-z0-9_-]+",
      "(?i)\\b[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\b"
    ],
    "forbidden_fixture_fields": [
      "freeTextAnswer",
      "rawData",
      "sourcePath",
      "projectId",
      "ledgerId",
      "recentItems"
    ]
  },
