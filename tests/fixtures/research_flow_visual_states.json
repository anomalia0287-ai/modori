    "performance_baseline": {
      "measured_at_utc": "2026-07-17T22:04:05Z",
      "command": ".venv/Scripts/python.exe -m pytest tests/ui/test_research_flow_qml.py -q -p no:cacheprovider --durations=12",
      "environment_class": "current-development-pc",
      "closed_state_runtime_load_ms": 720,
