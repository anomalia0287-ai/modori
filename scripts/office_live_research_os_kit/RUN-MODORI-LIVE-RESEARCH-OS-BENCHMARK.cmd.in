@echo off
setlocal
set "MODORI_KIT_ROOT=%~dp0"
powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$p=Join-Path $env:MODORI_KIT_ROOT 'VERIFY-AND-RUN.ps1'; if (-not (Test-Path -LiteralPath $p -PathType Leaf)) { Write-Host '오류 코드: powershell_bootstrap_missing'; exit 70 }; $s=[System.IO.File]::Open($p,[System.IO.FileMode]::Open,[System.IO.FileAccess]::Read,[System.IO.FileShare]::Read); try { $a=[System.Security.Cryptography.SHA256]::Create(); try { $h=([System.BitConverter]::ToString($a.ComputeHash($s))).Replace('-','').ToLowerInvariant() } finally { $a.Dispose() }; if ($h -ne '__POWERSHELL_SHA256__') { Write-Host '오류 코드: powershell_bootstrap_digest_mismatch'; exit 71 }; & $p; $c=$LASTEXITCODE } finally { $s.Dispose() }; exit $c"
set "MODORI_EXIT=%ERRORLEVEL%"
if not "%MODORI_KIT_NONINTERACTIVE%"=="1" pause
exit /b %MODORI_EXIT%
